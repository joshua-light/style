{
  "theme": "base",
  "look": "classic",
  "fontFamily": "Expressway, Fira Sans, sans-serif",
  "flowchart": { "useMaxWidth": false, "curve": "step", "htmlLabels": false, "padding": 12, "nodeSpacing": 32, "rankSpacing": 40 },
  "sequence": { "useMaxWidth": false, "actorMargin": 48, "mirrorActors": false, "messageMargin": 32 },
  "themeVariables": {
    "darkMode": true,
    "fontFamily": "Expressway, Fira Sans, sans-serif",
    "fontSize": "14px",
    "background": "#333333",
    "primaryColor": "#2b2b2b",
    "primaryTextColor": "#d9d9d9",
    "primaryBorderColor": "#000000",
    "secondaryColor": "#3f3f3f",
    "secondaryTextColor": "#d9d9d9",
    "secondaryBorderColor": "#000000",
    "tertiaryColor": "#212121",
    "tertiaryTextColor": "#a3a3a3",
    "tertiaryBorderColor": "#000000",
    "lineColor": "#a3a3a3",
    "textColor": "#a3a3a3",
    "mainBkg": "#2b2b2b",
    "nodeBorder": "#000000",
    "nodeTextColor": "#d9d9d9",
    "clusterBkg": "#212121",
    "clusterBorder": "#000000",
    "titleColor": "#a3a3a3",
    "edgeLabelBackground": "#333333",
    "actorBkg": "#2b2b2b",
    "actorBorder": "#000000",
    "actorTextColor": "#d9d9d9",
    "actorLineColor": "#000000",
    "signalColor": "#a3a3a3",
    "signalTextColor": "#a3a3a3",
    "labelBoxBkgColor": "#3f3f3f",
    "labelBoxBorderColor": "#000000",
    "labelTextColor": "#d9d9d9",
    "loopTextColor": "#a3a3a3",
    "noteBkgColor": "#3f3f3f",
    "noteTextColor": "#d9d9d9",
    "noteBorderColor": "#000000",
    "activationBkgColor": "#3f3f3f",
    "activationBorderColor": "#000000",
    "pie1": "#528ebf",
    "pie2": "#c3ad48",
    "pie3": "#9466ba",
    "pie4": "#ce7b47",
    "pie5": "#bec1c6",
    "pie6": "#d28aac",
    "pie7": "#7a7a7a",
    "pieStrokeColor": "#000000",
    "pieOuterStrokeColor": "#000000",
    "pieStrokeWidth": "1px",
    "pieOuterStrokeWidth": "1px",
    "pieTitleTextColor": "#d9d9d9",
    "pieSectionTextColor": "#000000",
    "pieLegendTextColor": "#a3a3a3",
    "pieOpacity": "1"
  },
  "themeCSS": "rect, .node rect, .cluster rect, .actor, .note, .labelBox { rx: 0; ry: 0; } .cluster-label text, .cluster text { font-size: 12px; font-weight: 700; text-transform: uppercase; } .flowchart-link, .messageLine0, .messageLine1 { stroke-width: 2px; stroke-linejoin: miter; filter: drop-shadow(1px 0 0 #000) drop-shadow(-1px 0 0 #000) drop-shadow(0 1px 0 #000) drop-shadow(0 -1px 0 #000); } .messageLine1 { stroke-dasharray: none !important; } .actor-line { stroke: #000; stroke-width: 2px; } .edgeLabel text, .messageText { font-size: 12px; }"
}
